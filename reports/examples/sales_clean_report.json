          "%Y-%m-%d",
          "%d/%m/%Y",
          "%m/%d/%Y"
        ]
      }
    ],
    "numbers": [
      {
        "decimal": ".",
        "thousands": null,
        "strip_chars": "",
        "allow_leading_zeros": false,
        "on_error": "keep",
        "column": "quantity"
      },
      {
        "decimal": ".",
        "thousands": ",",
        "strip_chars": "$",
        "allow_leading_zeros": false,
        "on_error": "keep",
        "column": "unit_price"
      }
    ],
    "duplicates": {
      "remove_exact": true,
      "key_columns": [
        "order_id",
        "sku"
      ],
      "remove_key_duplicates": false,
      "keep": "first"
    },
    "validation": [
      {
        "id": "order_id_present",
        "rule": "not_null",
        "column": "order_id",
        "action": "quarantine"
      },
      {
        "id": "channel_allowed",
        "rule": "allowed_values",
        "column": "channel",
        "values": [
          "Online",
          "Store",
          "Phone"
        ],
        "action": "quarantine"
      },
      {
        "id": "region_present",
        "rule": "not_null",
        "column": "region"
      },
      {
        "id": "region_allowed",
        "rule": "allowed_values",
        "column": "region",
        "values": [
          "North",
          "South",
          "East",
          "West"
        ]
      },
      {
        "id": "order_date_is_iso_date",
        "rule": "type",
        "column": "order_date",
        "expected": "date"
      },
      {
        "id": "order_date_in_september",
        "rule": "date_range",
        "column": "order_date",
        "min": "2026-09-01",
        "max": "2026-09-30"
      },
      {
        "id": "quantity_present",
        "rule": "not_null",
        "column": "quantity"
      },
      {
        "id": "quantity_at_least_1",
        "rule": "range",
        "column": "quantity",
        "min": 1
      },
      {
        "id": "unit_price_is_number",
        "rule": "type",
        "column": "unit_price",
        "expected": "number"
      },
      {
        "id": "sku_5_digits",
        "rule": "pattern",
        "column": "sku",
        "regex": "[0-9]{5}"
      },
      {
        "id": "order_line_unique",
        "rule": "unique",
        "columns": [
          "order_id",
          "sku"
        ]
      }
    ]
  },
